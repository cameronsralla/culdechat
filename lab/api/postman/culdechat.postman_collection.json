{
  "info": {
    "name": "culdechat",
    "description": "Prefer the generated Swagger UI at http://localhost:8080/api/docs/index.html. This collection is a small smoke set.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "culdechatBase",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{culdechatBase}}/api/health"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@culdechat.local\",\n  \"password\": \"changeme123\"\n}"
        },
        "url": "{{culdechatBase}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  const data = pm.response.json();",
              "  if (data && data.token) {",
              "    pm.collectionVariables.set('token', data.token);",
              "  }",
              "} catch (e) { /* ignore parse errors */ }"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{culdechatBase}}/api/auth/me"
      }
    },
    {
      "name": "General feed",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{culdechatBase}}/api/posts"
      }
    }
  ]
}
