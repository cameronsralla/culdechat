# Copy to .env and fill in. Everything here is deploy-time config; runtime
# settings (community name, tier, invite expiry) are edited in the admin UI.

# Public hostname pointing at this box (A/AAAA record). Caddy gets TLS automatically.
DOMAIN=square.example.org
ACME_EMAIL=you@example.org

# Postgres password for the culdechat user (generate: openssl rand -hex 24)
DB_PASSWORD=change-me

# At least 32 random bytes (generate: openssl rand -base64 48)
JWT_SECRET=change-me-change-me-change-me-change-me

# Outbound email for invites (required in prod)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=noreply@square.example.org
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true

# First admin, created only when the users table is empty. Remove after first boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_UNIT=Admin

# Backups: host directory and retention
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Optional: build label shown by /healthz
VERSION=dev
